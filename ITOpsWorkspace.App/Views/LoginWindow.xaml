<Window x:Class="ITOpsWorkspace.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITOpsWorkspace — Log In" Height="460" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontSize="14" ResizeMode="NoResize">

    <StackPanel Margin="30">

        <StackPanel Visibility="{Binding IsChoosingGroup, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="Log In" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Enter your ServiceNow username and password."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Username" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10" Margin="0,0,0,14" Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"/>

            <TextBlock Text="Password" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Padding="10" Margin="0,0,0,14"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"/>

            <Button Content="Log In" Click="OnLoginClicked" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsChoosingGroup, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Select Your Team" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="You belong to more than one ServiceNow group. Choose the one that represents your primary team for My Team Work."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding DebugGroupCount}" Foreground="{StaticResource WarningBrush}"
                       FontSize="12" Margin="0,0,0,14"/>

            <TextBlock Text="Assignment Group" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                      ItemsSource="{Binding AvailableGroups}" SelectedItem="{Binding SelectedGroup}"
                      Height="40" Margin="0,0,0,20"/>

            <Button Content="Continue" Click="OnConfirmGroupClicked" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                   Margin="0,14,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>