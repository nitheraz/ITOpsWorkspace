<UserControl x:Class="ITOpsWorkspace.App.Views.AssetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="30">
        <Button DockPanel.Dock="Top" Content="← Back" Command="{Binding BackCommand}"
                Style="{StaticResource RowButtonStyle}" HorizontalAlignment="Left"
                Padding="10,6" Margin="0,0,0,20" Cursor="Hand"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Asset.Name}" FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Asset.ClassName}" FontSize="14"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

        <UniformGrid Columns="2" Rows="4">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Manufacturer / Model" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0">
                        <Run Text="{Binding Asset.Manufacturer}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Asset.Model}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Serial Number" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding Asset.SerialNumber}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Asset Tag" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding Asset.AssetTag}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding Asset.OperationalStatus}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Site / Location" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding Asset.SiteName}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Assigned To" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding Asset.AssignedToName}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </DockPanel>
</UserControl>