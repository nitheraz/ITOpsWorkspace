<Window x:Class="ITOpsWorkspace.App.Views.OrgSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITOpsWorkspace — Organization Setup" Height="380" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontSize="14" ResizeMode="NoResize">

    <StackPanel Margin="30">
        <TextBlock Text="Organization Setup" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="This is a one-time setup for this machine. Enter your organization's ServiceNow instance URL — individual users will log in with their own credentials afterward."
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24"
                   TextWrapping="Wrap"/>

        <TextBlock Text="ServiceNow Instance URL" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding InstanceUrl, UpdateSourceTrigger=PropertyChanged}"
                 Padding="10" Margin="0,0,0,14" Background="{StaticResource SurfaceBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                   Margin="0,0,0,14" TextWrapping="Wrap"/>

        <Button Content="Save and Continue" Click="OnSaveClicked" Padding="12" Cursor="Hand"
                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
    </StackPanel>
</Window>