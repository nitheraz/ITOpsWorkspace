<UserControl x:Class="ITOpsWorkspace.App.Views.MyTeamWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="30">
        <TextBlock DockPanel.Dock="Top" Text="My Team Work" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding DebugAssignmentGroupName, StringFormat='Debug: Assignment Group = {0}'}"
                   Foreground="{StaticResource WarningBrush}" FontSize="13" Margin="0,0,0,16"/>

        <!-- Status filter tabs -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding StatusFilters}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}"
                            Command="{Binding DataContext.SetStatusFilterCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Padding="16,8" Margin="0,0,8,0"
                            BorderThickness="0" Cursor="Hand" FontSize="14">
                        <Button.Background>
                            <MultiBinding Converter="{StaticResource FilterTabStyleConverter}" ConverterParameter="Background">
                                <Binding/>
                                <Binding Path="DataContext.StatusFilter"
                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Button.Background>
                        <Button.Foreground>
                            <MultiBinding Converter="{StaticResource FilterTabStyleConverter}" ConverterParameter="Foreground">
                                <Binding/>
                                <Binding Path="DataContext.StatusFilter"
                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Button.Foreground>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Workload row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,24">
            <ItemsControl ItemsSource="{Binding Workload}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" Width="170">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource StatLabelStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Count}" Style="{StaticResource StatNumberStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Pagination footer -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"
                    Padding="14,8" Margin="0,0,10,0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}"
                       VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Button Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                    Padding="14,8" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TeamIncidents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>

                                <Button Style="{StaticResource RowButtonStyle}"
                                        Command="{Binding DataContext.ToggleSelectCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="12" Height="12"
                                                 VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="1" Text="{Binding Number}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" FontSize="15"/>

                                        <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" FontSize="17"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="3" Text="{Binding PriorityDisplay}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" FontSize="14" Margin="10,0"/>

                                        <TextBlock Grid.Column="4"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding AssignedToName}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AssignedToName}" Value="">
                                                            <Setter Property="Text" Value="Unassigned"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="5" Text="{Binding RequesterName}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" FontSize="14"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Button>

                                <Border Margin="0,16,0,0" Padding="18" CornerRadius="8"
                                        Background="#1F8B5CF6"
                                        BorderBrush="#4D8B5CF6"
                                        BorderThickness="1">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource IncidentSelectedToVisibilityConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.SelectedIncident"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Border.Visibility>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="230"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="Description" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" FontSize="15"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Status" Style="{StaticResource StatLabelStyle}"/>
                                                <TextBlock Text="{Binding StateDisplay}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Requester" Style="{StaticResource StatLabelStyle}"/>
                                                <TextBlock Text="{Binding RequesterName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Created" Style="{StaticResource StatLabelStyle}"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>