<UserControl x:Class="ITOpsWorkspace.App.Views.IncidentWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="30">
        <Button DockPanel.Dock="Top" Content="← Back" Command="{Binding BackCommand}"
                Style="{StaticResource RowButtonStyle}" HorizontalAlignment="Left"
                Padding="10,6" Margin="0,0,0,20" Cursor="Hand"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Header -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Incident.Number}"
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Incident.StateDisplay}"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
                <TextBlock Text="{Binding Incident.Title}" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"
                           TextWrapping="Wrap"/>

                <!-- Summary -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Incident.Description}"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Key info cards -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Requester" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock Text="{Binding Incident.RequesterName}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Assigned To" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Incident.AssignedToName}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Incident.AssignedToName}" Value="">
                                                <Setter Property="Text" Value="Unassigned"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Priority" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock Text="{Binding Incident.PriorityDisplay}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Created" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock Text="{Binding Incident.CreatedAt, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Placeholder for future work — being upfront rather than faking data -->
                <Border Style="{StaticResource CardStyle}">
                    <TextBlock Text="Activity timeline and suggested actions are planned for a future update."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>