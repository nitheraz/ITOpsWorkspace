<UserControl x:Class="ITOpsWorkspace.App.Views.PlaybooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="30">
        <TextBlock DockPanel.Dock="Top" Text="Playbooks" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Button Content="+ New Playbook" Command="{Binding NewPlaybookCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <ItemsControl ItemsSource="{Binding Playbooks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Steps.Count, StringFormat='{}{0} steps'}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Edit"
                                            Command="{Binding DataContext.EditPlaybookCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeletePlaybookCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerSecondaryButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock Text="Title" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10" Margin="0,0,0,14" Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"/>

                <TextBlock Text="Description" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditingDescription, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                         Padding="10" Margin="0,0,0,20" Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"/>

                <TextBlock Text="Steps" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding EditingSteps}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10" Background="{StaticResource SurfaceBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"/>
                                <Button Grid.Column="2" Content="✕"
                                        Command="{Binding DataContext.RemoveStepCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerSecondaryButtonStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ Add Step" Command="{Binding AddStepCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding SavePlaybookCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>