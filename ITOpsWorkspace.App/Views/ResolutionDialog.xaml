<Window x:Class="ITOpsWorkspace.App.Views.ResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve Incident"
        Width="540"
        Height="430"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#17191F"
        Foreground="#F1F2F5"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Resolve Incident"
                       FontSize="23"
                       FontWeight="Bold"/>
            <TextBlock Text="Provide the resolution details before closing this incident."
                       Margin="0,6,0,0"
                       Foreground="#A8ACB8"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Resolution code *"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>


            <ComboBox x:Name="ResolutionCodeComboBox"
          Style="{StaticResource DarkComboBoxStyle}"
          ItemsSource="{Binding ResolutionCodes}"
          DisplayMemberPath="Label"
          SelectedValuePath="Value"
          Height="36"/>


        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Resolution notes *"
                   FontWeight="SemiBold"
                   Margin="0,0,0,7"/>

        <TextBox x:Name="ResolutionNotesTextBox"
                 Grid.Row="3"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="100"
                 Padding="10"
                 Background="#252832"
                 Foreground="#F1F2F5"
                 BorderBrush="#444957"
                 CaretBrush="#F1F2F5"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Background="#30343F"
                    Foreground="#F1F2F5"
                    BorderBrush="#444957"/>
            <Button Content="Resolve Incident"
                    Width="145"
                    Height="36"
                    IsDefault="True"
                    Click="ResolveButton_Click"
                    Background="#4263EB"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>