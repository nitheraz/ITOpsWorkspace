<Window x:Class="ITOpsWorkspace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ITOpsWorkspace.App.ViewModels"
        xmlns:views="clr-namespace:ITOpsWorkspace.App.Views"
        Title="ITOpsWorkspace" Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontSize="14">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyWorkViewModel}">
            <views:MyWorkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyTeamWorkViewModel}">
            <views:MyTeamWorkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentWorkspaceViewModel}">
            <views:IncidentWorkspaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaybooksViewModel}">
            <views:PlaybooksView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Bottom"
                        Content="Sign Out"
                        Style="{StaticResource NavButtonStyle}"
                        Command="{Binding SignOutCommand}"
                        Margin="8,0,8,20"/>

                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="ITOpsWorkspace" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold" Margin="20,0,0,28"/>
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding DataContext.NavigateToCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>
    </Grid>
</Window>